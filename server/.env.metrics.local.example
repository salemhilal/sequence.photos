# Copy to .env.metrics.local for `npm run metrics` (never commit .env.metrics.local).
# Not .env or .env.local: wrangler loads those itself, and would deploy with this token.
# The dashboard's Account home → Account ID.
CLOUDFLARE_ACCOUNT_ID=replace-me
# My Profile → API Tokens: a custom token with Account Analytics: Read.
CLOUDFLARE_API_TOKEN=replace-me
