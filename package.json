{
  "name": "sequence",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:store": "node scripts/app-store.mjs",
    "app:ui:dev": "vite --mode app --port 5176 --strictPort",
    "app:ui:build": "tsc -b && vite build --mode app",
    "server:dev": "npm --prefix server run dev",
    "server:deploy": "npm --prefix server run deploy",
    "server:deploy:dev": "npm --prefix server run deploy:dev",
    "server:test": "npm --prefix server test",
    "server:check": "npm --prefix server run check",
    "server:metrics": "npm --prefix server run metrics",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:app": "node scripts/e2e-app.mjs",
    "check": "node scripts/check-env.mjs && npm run format:check && npm run lint && tsc -b && npm test",
    "setup": "npm ci --prefix server && playwright install chromium webkit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bump": "node scripts/bump.mjs",
    "icons": "node scripts/icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "immer": "^11.1.18",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "MIT"
}
