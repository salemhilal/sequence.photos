# The website's domain: used in links to it (About → Privacy policy) and in its pages
# (index.html, privacy/index.html). Change it here when the site moves.
VITE_SITE_DOMAIN=sequence.photos
# The Mac app's App Store page, for the landing page's badge (index.html).
VITE_APP_STORE_URL=https://apps.apple.com/app/id6816730850
# The source code, linked from the landing page, support page, and About.
VITE_REPO_URL=https://github.com/salemhilal/sequence.photos
# Sequence's servers (the sequence-server repo), for posting to Instagram: the default,
# and the development one (Settings → Advanced can switch to it, or to a local
# `wrangler dev` at http://localhost:8787). Both are allowed by the web app's Content
# Security Policy (built from these in vite.config.ts).
VITE_SERVER_URL=https://sequence-server.sequence-photos.workers.dev
VITE_DEV_SERVER_URL=https://sequence-server-dev.sequence-photos.workers.dev
# The Instagram app (Meta dashboard → Instagram → API setup with Instagram login). Public.
VITE_INSTAGRAM_APP_ID=1673773837797048
