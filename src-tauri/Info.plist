<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by Tauri. -->
<plist version="1.0">
<dict>
  <!-- No encryption beyond what macOS provides, so App Store uploads skip export compliance questions. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- The icon in Assets.car (see scripts/icons.mjs): light or dark with the system on macOS 26
       and later. Older macOS uses icon.icns, the light one. -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <!-- The app's link, which brings an Instagram sign-in back from the browser (see src/instagram.ts). -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Instagram sign-in</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>sequence-photos</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
