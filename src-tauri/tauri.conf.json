{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sequence",
  "version": "0.1.2",
  "identifier": "io.salem.PhotobookSequencer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5176",
    "beforeDevCommand": "npm run app:ui:dev",
    "beforeBuildCommand": "npm run app:ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "app/index.html",
        "title": "Sequence",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 23
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://graph.instagram.com https://sequence-server.sequence-photos.workers.dev https://sequence-server-dev.sequence-photos.workers.dev http://localhost:* http://127.0.0.1:*",
        "img-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Photography",
    "copyright": "\u00a9 2026 Salem Hilal",
    "shortDescription": "A tool for playing with photo sequences",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "fileAssociations": [
      {
        "ext": ["photo-sequence"],
        "name": "Sequence Project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-photo-sequence",
        "contentTypes": ["io.salem.PhotobookSequencer.project"],
        "exportedType": {
          "identifier": "io.salem.PhotobookSequencer.project",
          "conformsTo": ["public.data", "public.content"]
        }
      }
    ]
  }
}
